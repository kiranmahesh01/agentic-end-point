# Agentic Endpoint Security - Environment Configuration
# Copy to .env and adjust values for your deployment

# Service URLs (for inter-service communication)
REGISTRY_URL=http://registry:8081
PDP_URL=http://pdp:8082
IDENTITY_URL=http://identity:8083
BROKER_URL=http://broker:8080
APPROVAL_URL=http://approval:8084
TELEMETRY_URL=http://telemetry:8085
KILLSWITCH_URL=http://killswitch:8086

# JWT Configuration
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=300

# Approval HMAC Secret
APPROVAL_HMAC_SECRET=CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET

# Approved file roots (comma-separated)
APPROVED_READ_ROOTS=/approved/workspace,/tmp/approved
APPROVED_WRITE_ROOTS=/approved/output

# Allowed egress domains (comma-separated)
DEFAULT_EGRESS_ALLOWLIST=reports.internal.example

# Policy enforcement
PDP_TIMEOUT_SECONDS=5
LOCAL_CACHE_TTL_SECONDS=5

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://telemetry:8085
OTEL_SERVICE_NAME=agentic-endpoint-security

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Demo mode (for testing without full infrastructure)
DEMO_MODE=false
